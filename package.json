{
  "name": "rs-ge",
  "version": "0.0.0",
  "description": "Typed, dependency-free client for the Georgian Revenue Service (rs.ge) SOAP services, authenticated with a service user. Runs on Node, Cloudflare Workers, Deno and Bun.",
  "license": "MIT",
  "author": "Leon Weber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leon-wbr/rs-ge.git"
  },
  "homepage": "https://github.com/leon-wbr/rs-ge#readme",
  "bugs": "https://github.com/leon-wbr/rs-ge/issues",
  "keywords": [
    "rs.ge",
    "georgia",
    "revenue-service",
    "tax",
    "waybill",
    "invoice",
    "soap",
    "cloudflare-workers"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rs-ge": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "generate": "node scripts/generate.ts",
    "wsdl:check": "node scripts/wsdl-check.ts",
    "probe": "node src/cli.ts probe"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
